NODE_ENV=development
PORT=3000
DATABASE_URL=
PUBLIC_WIDGET_ORIGIN=
JWT_SECRET=
TRUST_PROXY_HOPS=0

# Requeridas solo para `npm run bootstrap:admin`. El negocio y su administrador
# se crean en una misma transaccion; el comando falla si el slug o el email ya
# existen, para no sobrescribir una contrasena en uso.
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_BUSINESS_SLUG=
BOOTSTRAP_TIMEZONE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
